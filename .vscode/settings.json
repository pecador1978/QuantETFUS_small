{
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
  "python.envFile": "${workspaceFolder}/.env",

  // Help Python find shared modules in the editor (intellisense)
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "/Users/Finance/QuantShared"
  ],

  // Ensure terminals import the SMALL project's settings first
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}:/Users/Finance/QuantShared",
    "PROJECT_ROOT": "${workspaceFolder}"
  },

  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/venv": true,
    "**/logs": true,
    "**/merged_datasets": true,
    "**/param_results": true,
    "**/data_final_training": true,
    "**/models": true
  },
  "search.exclude": {
    "**/venv": true,
    "**/logs": true,
    "**/merged_datasets": true,
    "**/param_results": true,
    "**/data_final_training": true,
    "**/models": true
  },
  "python.analysis.exclude": [
    "venv",
    "logs",
    "merged_datasets",
    "param_results",
    "data_final_training",
    "models"
  ]
}