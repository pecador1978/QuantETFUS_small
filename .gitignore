# =========================
# QuantETFUS_small .gitignore
# =========================

# --- Data folders (large, generated, handled via iCloud QuantShared) ---
data_raw/
data_enriched/
merged_datasets/
data_final_training/
param_results/
signals/
boards/
models/
output/
site/
_trash_*/

# --- Large file types (never in GitHub) ---
*.parquet
*.csv
*.pkl
*.h5
*.feather
*.npz
*.npy

# --- Config backups / autosaves ---
*_backup.json
*.save
*.bak
*.tmp
*.old

# --- Python / runtime noise ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
.ipynb_checkpoints/

# --- Virtual environments ---
venv/
.env/
.venv/

# --- OS / editor noise ---
.DS_Store
*.swp
*.swo

# --- Optional: IDE/project files ---
.vscode/
.idea/
