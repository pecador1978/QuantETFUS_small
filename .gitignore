boards/
models/
output/
site/
_trash_*/

# --- Large file types (never in GitHub) ---
*.parquet
*.csv
*.pkl
*.h5
*.feather
*.npz
*.npy

# --- Python / runtime noise ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.ipynb_checkpoints/
*.log

# --- Virtual environments ---
venv/
.env/
.venv/

# --- OS / editor noise ---
.DS_Store
*.swp
*.swo
*.bak

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- Optional: IDE/project files ---
.vscode/
.idea/
